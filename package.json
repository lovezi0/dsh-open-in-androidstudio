{
  "name": "dsh-open-in-androidstudio",
  "version": "0.1.0",
  "description": "Open the current workspace in Android Studio from the DSH session header, with all locally installed Android Studio versions selectable.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": ">=3.18.3 <4.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "selftest": "node --import ./tests/register-stub.mjs tests/host-selftest.mjs && node tests/client-selftest.mjs"
  }
}
